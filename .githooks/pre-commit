#!/bin/sh
# Trava de entrega: nenhum commit entra com a bateria vermelha.
# Ligar uma vez por máquina:  git config core.hooksPath .githooks
#
# Pular num caso justificado:  git commit --no-verify
# Se você está pulando com frequência, o problema é o teste, não o gate.

# 1. interpretador declarado, 2. venv do projeto, 3. o do sistema
PY="${RADAR_PYTHON:-}"
[ -n "$PY" ] && [ -x "$PY" ] || PY=".venv/bin/python"
[ -x "$PY" ] || PY="python3"

if ! "$PY" -c "import pytest" 2>/dev/null; then
  echo "COMMIT BLOQUEADO: $PY não tem pytest."
  echo "Crie o ambiente (python3 -m venv .venv && .venv/bin/pip install -r requirements.txt -r requirements-dev.txt)"
  echo "ou aponte RADAR_PYTHON para um interpretador que tenha."
  exit 1
fi

echo "pre-commit: rodando a bateria..."
if ! "$PY" -m pytest -q --ignore=tests/e2e >/tmp/pre-commit-radar.log 2>&1; then
  echo
  echo "COMMIT BLOQUEADO: a bateria de testes falhou."
  tail -15 /tmp/pre-commit-radar.log
  echo
  echo "Saída completa em /tmp/pre-commit-radar.log"
  exit 1
fi

tail -1 /tmp/pre-commit-radar.log

# A CI roda `ruff check .` e reprova. Sem isto aqui, a bateria verde esconde
# uma CI vermelha, e só o GitHub avisa — depois do push.
if ! "$PY" -m ruff check . >/tmp/pre-commit-ruff.log 2>&1; then
  echo
  echo "COMMIT BLOQUEADO: o ruff reprovou."
  tail -10 /tmp/pre-commit-ruff.log
  exit 1
fi
echo "pre-commit: ruff limpo"
exit 0
